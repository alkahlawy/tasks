@model ResetPasswordViewModel
@{
    ViewData["Title"] = "ResetPassword";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}


<div class="main-agileinfo">
    <div class="agileits-top">
        <form asp-action="ResetPasswordLink" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All"></div>
            <input type="hidden" name="email" value="@ViewData["email"]" />
            <input type="hidden" name="token" value="@ViewData["token"]" />
            <input asp-for="NewPassword" placeholder="New Password" required="">
            <span asp-validation-for="NewPassword"></span>
            <br />
            <input asp-for="ConfirmNewPassword" placeholder="Confirm New Password" required="">
            <span asp-validation-for="ConfirmNewPassword"></span>
            <br />

            <input type="submit" value="Change Password">
        </form>
        <p> <a asp-action="Login">Cancel</a></p>
    </div>
</div>
